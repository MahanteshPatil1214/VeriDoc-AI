<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="applicationName" source="spring.application.name"/>
    <!-- LOG_FORMAT=json switches to the structured encoder; anything else is console. -->
    <springProperty scope="context" name="logFormat" source="LOG_FORMAT" defaultValue="console"/>

    <!-- Human readable console output with correlation IDs in the MDC. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Structured JSON for log aggregation. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"veridoc-ai-backend"}</customFields>
            <includeMdcKeyName>traceId</includeMdcKeyName>
            <includeMdcKeyName>userId</includeMdcKeyName>
        </encoder>
    </appender>

    <!-- Production defaults to WARN + JSON regardless of LOG_FORMAT. -->
    <springProfile name="prod">
        <root level="WARN">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>

    <springProfile name="!prod">
        <if condition='property("logFormat").equals("json")'>
            <then>
                <root level="INFO">
                    <appender-ref ref="JSON"/>
                </root>
            </then>
            <else>
                <root level="INFO">
                    <appender-ref ref="CONSOLE"/>
                </root>
            </else>
        </if>
    </springProfile>
</configuration>