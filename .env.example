# ---- VeriDoc AI :: environment template ----
# Copy to .env and fill in real values. Never commit .env.

# --- Google Gemini ---
# Backend-only. Never exposed to the browser or bundled into client code.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
# Must match the vector(N) width in db/migration/V1__init.sql
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_VERSION=1
GEMINI_TIMEOUT=60s
GEMINI_MAX_OUTPUT_TOKENS=2048

# --- PostgreSQL + pgvector ---
DATABASE_NAME=veridoc
DATABASE_URL=jdbc:postgresql://localhost:5432/veridoc
DATABASE_USERNAME=veridoc
DATABASE_PASSWORD=change-me
DATABASE_POOL_SIZE=10
# Host-side port for docker compose (the container always listens on 5432).
DATABASE_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
# noeviction: rate-limit counters must not be silently dropped under pressure.
REDIS_MAXMEMORY=256mb

# --- Auth ---
# Minimum 32 bytes. Generate with:
#   openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=veridoc-ai
JWT_ACCESS_TTL=PT1H
JWT_REFRESH_TTL=P30D

# --- Storage ---
STORAGE_ROOT=./data/storage
# 20 MiB
MAX_FILE_SIZE=20MB
MAX_FILE_SIZE_BYTES=20971520
MAX_REQUEST_SIZE=22MB
MAX_PDF_PAGES=500

# --- Chunking ---
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
CHUNK_MIN_TOKENS=40

# --- Retrieval ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=40
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_MAX_DOCS=20

# --- RAG ---
RAG_HISTORY_MESSAGES=8
RAG_MAX_CONTEXT_TOKENS=12000
RAG_ENABLE_QUERY_REWRITING=true
RAG_DEBUG_ENABLED=false

# --- Resilience ---
AI_MAX_ATTEMPTS=3
AI_INITIAL_BACKOFF=PT1S
AI_MAX_BACKOFF=PT20S
EMBEDDING_BATCH_SIZE=32

# --- Rate limits (permits/period) ---
RATE_LIMIT_ENABLED=true
RL_LOGIN=10/PT1M
RL_UPLOAD=20/PT1H
RL_CHAT=60/PT1H
RL_PROCESSING=30/PT1H

# --- Misc ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
LOG_LEVEL=INFO
LOG_FORMAT=console